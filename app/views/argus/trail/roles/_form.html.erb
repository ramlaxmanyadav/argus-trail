<%= form_with model: role, url: (role.persisted? ? role_path(role) : roles_path), class: "space-y-6" do |f| %>
  <% if role.errors.any? %>
    <div class="bg-red-50 border-l-4 border-red-400 p-4 rounded-lg">
      <p class="text-sm font-semibold text-red-700 mb-1"><%= pluralize(role.errors.count, "error") %> prevented saving:</p>
      <ul class="list-disc list-inside space-y-0.5">
        <% role.errors.full_messages.each do |msg| %>
          <li class="text-sm text-red-600"><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <label class="block text-sm font-semibold text-gray-700 mb-1">Role Name <span class="text-red-500">*</span></label>
    <%= f.text_field :name, class: "block w-full px-3 py-2 border border-gray-300 rounded-lg text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
  </div>

  <div>
    <label class="block text-sm font-semibold text-gray-700 mb-1">Description <span class="text-red-500">*</span></label>
    <%= f.text_area :description, rows: 2,
        class: "block w-full px-3 py-2 border border-gray-300 rounded-lg text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 resize-none" %>
  </div>

  <div>
    <label class="block text-sm font-semibold text-gray-700 mb-3">Permissions</label>

    <div class="space-y-4">
      <% @grouped_permissions.sort_by { |module_name, _| module_name.to_s }.each do |module_name, permissions| %>
        <div class="argus-trail-permission-group border border-gray-200 rounded-lg overflow-hidden">
          <div class="flex items-center gap-2 bg-gray-50 px-4 py-2 border-b border-gray-200">
            <input type="checkbox" class="argus-trail-module-toggle h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"
                   <%= "checked" if permissions.all? { |p| role.permission_ids.include?(p.id) } %>
                   onclick="const group = this.closest('.argus-trail-permission-group'); group.querySelectorAll('.argus-trail-permission-checkbox').forEach(cb => cb.checked = this.checked)">
            <span class="text-sm font-semibold text-gray-700">
              <%= module_name.present? ? module_name.humanize : "General" %>
            </span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 p-4">
            <% permissions.each do |permission| %>
              <label class="flex items-start gap-3 p-3 border border-gray-200 rounded-lg hover:border-indigo-300 hover:bg-indigo-50/50 cursor-pointer">
                <input type="checkbox" name="permission_ids[]" value="<%= permission.id %>"
                       <%= "checked" if role.permission_ids.include?(permission.id) %>
                       class="argus-trail-permission-checkbox mt-0.5 h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"
                       onchange="const group = this.closest('.argus-trail-permission-group'); group.querySelector('.argus-trail-module-toggle').checked = [...group.querySelectorAll('.argus-trail-permission-checkbox')].every(cb => cb.checked)">
                <div>
                  <p class="text-sm font-medium text-gray-800"><%= permission.module_permission? ? permission.action.humanize : permission.name.humanize %></p>
                  <p class="text-xs text-gray-500 mt-0.5"><%= permission.description %></p>
                </div>
              </label>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <% if @grouped_permissions.empty? %>
      <p class="text-sm text-gray-400 italic mt-2">
        No permissions exist yet. <%= link_to "Create one first", new_permission_path %>, or run
        <code class="bg-gray-100 px-1 rounded">bin/rails argus_trail:fetch_permissions</code> to generate them from your routes.
      </p>
    <% end %>
  </div>

  <div class="flex items-center gap-3 pt-2 border-t border-gray-100">
    <%= f.submit class: "px-5 py-2 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 cursor-pointer" %>
    <%= link_to "Cancel", roles_path, class: "px-5 py-2 bg-white text-gray-700 text-sm font-semibold border border-gray-300 rounded-lg hover:bg-gray-50" %>
  </div>
<% end %>
